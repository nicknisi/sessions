---
import SessionRow from './SessionRow.astro';

/**
 * The MCP pillar's signature moment: an agent reaching back along the spine.
 *
 * The layout carries the semantics. History runs oldest-first downward, the way
 * the page's spine does, so "earlier" is literally "higher" — and the arm the
 * agent throws to recall a decision therefore points UP, out of now and into
 * the past. Nothing about that is decorative; reverse the order and the arrow
 * would be lying.
 *
 * All four sessions are invented. The figure says so.
 */
const HISTORY = [
  { date: 'mar 3', project: 'authkit-web', tool: 'claude' as const, prompt: 'Refactor the auth middleware to use JWT', hit: true },
  { date: 'mar 9', project: 'authkit-web', tool: 'pi' as const, prompt: 'Help me debug the flaky integration test', hit: false },
  { date: 'apr 22', project: 'api-server', tool: 'codex' as const, prompt: 'Add rate limiting to the /api/v2 endpoints', hit: false },
];
---

<figure class="recall m-0" data-recall>
  <div class="ledger relative">
    <div class="lrail" aria-hidden="true"></div>

    <ol class="m-0 grid list-none gap-4 p-0">
      {
        HISTORY.map(session => (
          <li class="row relative pl-[74px] max-[560px]:pl-8" data-hit={String(session.hit)}>
            <span class="ldot" aria-hidden="true" />
            <span class="ldate meta-label">{session.date}</span>
            <SessionRow {...session} />
          </li>
        ))
      }
    </ol>

    {/* The reach: a dashed run up the local rail, arrowhead landing on the hit. */}
    <div class="arm" aria-hidden="true">
      <span class="head"></span>
    </div>
  </div>

  <p class="reach meta-label mt-3 mb-0 pl-[74px] max-[560px]:pl-8">
    <span class="text-accent">↑</span> reached back 4 months, unprompted
  </p>

  <div class="mt-5 grid gap-2.5 rounded-card border border-line bg-shell px-5 py-4 font-mono text-[12.5px] leading-[1.65] max-[560px]:px-3.5">
    <div class="text-ink-3">
      <span class="text-accent">agent</span> · you asked why refresh tokens rotate here
    </div>
    <div class="text-ink">
      <span class="text-accent select-none">→</span> search_sessions({'{'} query: <span class="text-accent">"jwt refresh rotation"</span> {'}'})
    </div>
    <div class="text-ink-2">
      <span class="select-none text-ink-3">←</span> 3 sessions · best hit
      <span class="text-ink">authkit-web</span>, mar 3, msg#41
    </div>
    <div class="text-ink-2">
      <span class="select-none text-ink-3">←</span> get_session_digest(mar 3) → the whole arc, ~2k tokens
    </div>
  </div>
</figure>

<style>
  .lrail {
    position: absolute;
    left: 58px;
    top: 4px;
    bottom: -6px;
    width: 1px;
    background: var(--line);
  }
  .ldot {
    position: absolute;
    left: 58px;
    top: 5px;
    translate: -50% 0;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--ink-3);
    transition:
      background 0.2s ease-out,
      scale 0.2s ease-out;
  }
  .ldate {
    position: absolute;
    left: 0;
    top: 1px;
    width: 44px;
    text-align: right;
  }

  .arm {
    position: absolute;
    left: 58px;
    top: 8px;
    bottom: -6px;
    width: 0;
    border-left: 1px dashed var(--accent);
    /* Grows upward out of "now" into the past. Scale and opacity only, so the
       reveal never touches layout. */
    transform-origin: bottom;
    scale: 1 0;
    opacity: 0;
    transition:
      scale 0.55s cubic-bezier(0.22, 1, 0.36, 1),
      opacity 0.2s ease-out;
  }
  .head {
    position: absolute;
    top: -1px;
    left: -4px;
    width: 0;
    height: 0;
    border-left: 4.5px solid transparent;
    border-right: 4.5px solid transparent;
    border-bottom: 6px solid var(--accent);
    opacity: 0;
    transition: opacity 0.2s ease-out 0.45s;
  }
  .reach {
    opacity: 0;
    transition: opacity 0.3s ease-out 0.5s;
  }

  /* The hit is dim until the recall lands on it. */
  .row[data-hit='true'] .ldot {
    background: var(--ink-3);
  }

  [data-recall].on .arm {
    scale: 1 1;
    opacity: 1;
  }
  [data-recall].on .head,
  [data-recall].on .reach {
    opacity: 1;
  }
  [data-recall].on .row[data-hit='true'] .ldot {
    background: var(--accent);
    scale: 1.3;
  }

  @media (max-width: 560px) {
    .lrail,
    .ldot,
    .arm {
      left: 16px;
    }
    .ldate {
      position: static;
      display: block;
      width: auto;
      text-align: left;
      margin-bottom: 2px;
    }
  }

  /* Without motion the figure is simply already in its landed state — the
     information is the point, the growth was only the telling of it. */
  @media (prefers-reduced-motion: reduce) {
    .arm {
      scale: 1 1;
      opacity: 1;
    }
    .head,
    .reach {
      opacity: 1;
    }
    .row[data-hit='true'] .ldot {
      background: var(--accent);
    }
  }
</style>

<script is:inline>
  (function () {
    var figure = document.querySelector('[data-recall]');
    if (!figure) return;
    // No JS, no IntersectionObserver, or reduced motion: the CSS above already
    // renders the landed state, so the figure is never blank.
    if (!('IntersectionObserver' in window)) return figure.classList.add('on');
    var io = new IntersectionObserver(
      function (entries) {
        entries.forEach(function (entry) {
          if (!entry.isIntersecting) return;
          entry.target.classList.add('on');
          io.unobserve(entry.target);
        });
      },
      { threshold: 0.45 },
    );
    io.observe(figure);
  })();
</script>
