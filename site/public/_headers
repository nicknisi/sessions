# Cloudflare reads this from the build output root. Both Pages and Workers
# static assets honour it.
#
# The site loads nothing from anywhere else — no CDNs, no images, no analytics,
# and the only fonts are self-hosted under /fonts — so the CSP can be almost
# entirely `self` and stay that way. `default-src 'self'` is what covers those
# font requests; there is deliberately no separate font-src.
# `unsafe-inline` is required for style-src and script-src because every page
# here inlines its CSS and its handful of scripts; that is the same property
# that makes the pages self-contained, and the same one the report and wrapped
# HTML have.
/*
  Referrer-Policy: strict-origin-when-cross-origin
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Content-Security-Policy: default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'
  Permissions-Policy: geolocation=(), camera=(), microphone=()

# Hashed build assets are immutable; the HTML must not be.
/_assets/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=31536000, immutable
